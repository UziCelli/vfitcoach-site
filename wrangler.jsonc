// Deploy: npm run deploy  (site estático servido pelo Cloudflare Workers; _headers é aplicado automaticamente)
{
  "name": "vfitcoach",
  "compatibility_date": "2026-09-25",
  // Só o domínio próprio: sem endereço *.workers.dev nem URLs de preview públicas.
  "workers_dev": false,
  "preview_urls": false,
  // Exigido pelo build de branches do Cloudflare (`npx wrangler preview`); sem isso o build falha.
  "previews": {},
  "routes": [
    { "pattern": "vfitcoachapp.com", "custom_domain": true },
    { "pattern": "www.vfitcoachapp.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
