{
  "name": "vfitcoach-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "headers": "node scripts/headers.mjs",
    "qa": "node scripts/qa.mjs",
    "security": "node scripts/security-check.mjs",
    "deploy": "npm run headers && npm run security -- --local && wrangler deploy",
    "headers:gislane": "node scripts/headers.mjs --site=gislane",
    "qa:gislane": "node scripts/qa.mjs --site=gislane",
    "security:gislane": "node scripts/security-check.mjs --site=gislane",
    "deploy:gislane": "npm run headers:gislane && npm run security:gislane -- --local && wrangler deploy -c wrangler.gislane.jsonc"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "lighthouse": "^13.5.0",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "wrangler": "^4.141.0"
  }
}
